{
	"name": "test",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "tsc -b && vp build",
		"preview": "vp preview",
		"lint": "vp lint",
		"deploy:prod": "pnpm exec wrangler pages deploy dist --project-name=dylanyeowf --branch=main",
		"deploy:staging": "pnpm exec wrangler pages deploy dist --project-name=dylanyeowf --branch=staging",
		"icons": "font-subset",
		"icons:watch": "font-subset --watch",
		"css": "tcm src",
		"css:watch": "tcm src --watch"
	},
	"packageManager": "pnpm@12.21.0",
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@iconify-icon/react": "^3.0.6",
		"lenis": "^1.3.27",
		"preact": "^11.2.0",
		"preact-iso": "^2.12.2",
		"react-github-calendar": "^5.0.9"
	},
	"devDependencies": {
		"@preact/preset-vite": "^2.10.6",
		"@types/node": "^26.6.6",
		"@yaboywf/font-subsetter": "^1.1.4",
		"eslint-plugin-no-unsanitized": "^4.1.5",
		"eslint-plugin-security": "^4.2.1",
		"node-addon-api": "^8.9.2",
		"node-gyp": "^13.1.0",
		"rollup-plugin-visualizer": "^7.1.3",
		"sharp": "^0.35.5",
		"typed-css-modules": "^0.9.1",
		"typescript": "~7.0.2",
		"vite": "catalog:",
		"vite-imagetools": "^12.0.2",
		"vite-plugin-pwa": "^2.0.0",
		"vite-plus": "catalog:",
		"wrangler": "^4.165.0"
	},
	"knip": {
		"entry": [
			"scripts/appleTouchIcon.js",
			"scripts/linkPreview.js"
		],
		"ignore": [
			"font-subset.config.mjs"
		],
		"ignoreDependencies": [
			"@fontsource-variable/geist",
			"playwright"
		]
	},
	"allowScripts": {
		"fsevents@2.3.3": true
	}
}
